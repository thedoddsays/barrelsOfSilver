; Engine configuration file.
; Barrels of Silver — a top-down age-of-sail prototype.
; Targets Godot 4.7+ (Forward+ renderer: Vulkan on Linux, D3D12/Vulkan on Windows).

config_version=5

[application]

config/name="Barrels of Silver"
config/description="Top-down age-of-sail pirate game: sailing by the wind and broadside combat."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Wind="*res://scripts/wind.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/default_angular_damp=0.1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=4096
